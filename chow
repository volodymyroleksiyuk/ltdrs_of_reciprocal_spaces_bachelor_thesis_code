rowspan = L -> (
    K = coefficientRing ring L;
    N = sub(jacobian gens trim L, K);
    transpose gens ker transpose N
);

reciprocalSpace = L -> (
    R = ring L;
    n = numgens R;
    P = product gens R;
    invImages = apply(toList(0..(n-1)), i -> product drop(gens R, {i,i}));
    invMap = map(R, R, invImages);
    saturate(invMap(L), P)
);

pluckerListFromStiefel = M -> (
    d = min(numgens source M, numgens target M);
    pluckerMatrix = exteriorPower(d, M);
    flatten entries pluckerMatrix 
);

ltdrOfReciprocal = L -> (
    R = ring L;
    K = coefficientRing R;
    n = dim R;
    M = rowspan(L);
    d = min(numgens source M, numgens target M);
    k = binomial(n-1, d-1);
    V = K^k;
    
    G = Grass(d-1, n-1, K);
    pLList = pluckerListFromStiefel M;

    -- Index lists to convert Plucker indeces to the iterator
    pIndeces = subsets(toList(0..(n-1)), d);
    vIndeces = subsets(toList(0..(n-2)), d-1);

    ltdr = matrix mutableMatrix(G, k, k);
    if not member(0_K, pLList) then (
        for j from 0 to binomial(n,d) -1 do (
            if member(n-1, pIndeces#j) then (
                vI = V_(j - binomial(n-1, d));
            )
            else (
                I = pIndeces#j;
                vI = 0_V;
                for l in I do(
                    Iwithoutl = delete(l, I);
                    IListIndex = position(vIndeces, x -> x==Iwithoutl);                                        
                    vI = vI + (-1)^(position(I, x -> x==l)) * V_IListIndex;                                  
                );
            );
            ltdr = ltdr + (1 / pLList#j) * (gens G)#j * matrix vI * transpose matrix vI;
        );
    );
    ltdr
);

lazyChowFormOfReciprocal = L -> (
    R = ring L;
    K = coefficientRing R;
    n = dim R;
    M = rowspan(L);
    d = min(numgens source M, numgens target M);
    k = binomial(n-1, d-1);
    V = K^k;
    
    G = Grass(d-1, n-1, K);
    pLList = pluckerListFromStiefel M;

    pIndeces = subsets(toList(0..(n-1)), d);
    vIndeces = subsets(toList(0..(n-2)), d-1);

    chcowMatrix = matrix mutableMatrix(K, k, k);
    if not member(0_K, pLList) then (
        for j from 0 to binomial(n,d) -1 do (
            if member(n-1, pIndeces#j) then (
                vI = V_(j - binomial(n-1, d));
            )
            else (
                I = pIndeces#j;
                vI = 0_V;
                for l in I do(
                    Iwithoutl = delete(l, I);
                    IListIndex = position(vIndeces, x -> x==Iwithoutl);                                        
                    vI = vI + (-1)^(position(I, x -> x==l)) * V_IListIndex;                                  
                );
            );
            jDual = position(pIndeces, x -> x == toList(0..(n-1)) - set pIndeces#j);
            fract = (1 / pLList#j) * (gens G)#jDual * (-1)^(0.5*d*(d-1) + sum(pIndeces#j));
            chcowMatrix = chcowMatrix + fract * matrix vI * transpose matrix vI;
        );
    );
    det(chcowMatrix)    
);

stupidChowFormOfReciprocal = L -> (
    phi = ltdrOfReciprocal(L);
    R = ring L;
    K = coefficientRing R;
    n = dim R;
    M = rowspan(L);
    d = min(numgens source M, numgens target M);

    G := Grass(d-1, n-1, K);
    P := ambient G;

    m := binomial(n,d);
    r := binomial(n,n-d);

    -- Polynomial ring in the beta-coordinates.
    B := K[b_0..b_(r-1)];

    -- Pluecker variables in the ambient polynomial ring
    -- and beta variables in the same indexing order.
    p := apply(m, i -> P_i);
    b := apply(r, i -> B_i);

    -- M2 orders the Pluecker variables according to subsets(n,d).
    dSubs := subsets(n,d);
    bdSubs := subsets(n,n-d);

    -- Coefficients of the linear functional u |-> u wedge beta.
    lambda := apply(dSubs, I -> (
        Iset := set I;

        -- complement of I, in increasing order
        J := select(toList(0..n-1),
                    j -> not member(j,Iset));

        -- location of J among the beta coordinates
        k := position(bdSubs,
                      J,
                      T -> T === J);

        -- sign of
        -- e_I wedge e_J = sign * e_0 wedge ... wedge e_(n-1)
        s := (-1)^((1/2)*sum apply(#I, t -> I#t - t));

        s * b#k
        ));

    -- Move the matrix to the ambient polynomial ring.
    phiP := lift(phi,P);

    -- Apply the linear functional entrywise.
    phiBeta := matrix(B,
        apply(entries phiP, row ->
            apply(row, f ->
                sum apply(m, i ->
                    lambda#i * promote(diff(p#i,f),B)
                )
            )
        )
    );

    (phiBeta, det phiBeta)
);

chowFormOfReciprocal = L -> (
    R = ring L;
    K = coefficientRing R;
    n = dim R;
    M = rowspan(L);
    d = min(numgens source M, numgens target M);
    k = binomial(n-1, d-1);
    
    G = Grass(d-1, n-1, K);
    
    pIndeces = subsets(toList(0..(n-1)), d);
    pIndecesDual = subsets(toList(0..(n-1)), n-d);

    ltdr = ltdrOfRecyprocal(L);
    GDual = Grass(n-d-1, n-1, K);

    imagesList = {};
    for j from 0 to binomial(n,d)-1 do (
        jDual = toList(0..(n-1)) - set pIndeces#j;
        sI = (-1)^((1/2)*d*(d-1) + sum(pIndeces#j));
        betaI = (gens GDual)#(position(pIndecesDual, x -> x==jDual));
        imagesList = append(imagesList, sI * betaI);
    );
    wedgeMap = map(GDual, G, imagesList);
    chowMatrix = wedgeMap(ltdr);
    det(chowMatrix)
);

